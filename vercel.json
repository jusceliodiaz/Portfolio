{
  "cleanUrls": false,
  "headers": [
    {
      "source": "/assets/(img|video)/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "jdiaz.vercel.app"
        }
      ],
      "destination": "https://www.schmidtjd.com/:path*",
      "permanent": true
    },
    {
      "source": "/yacht",
      "destination": "/yacht/",
      "permanent": false
    },
    {
      "source": "/projects.html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/de/projects.html",
      "destination": "/de/",
      "permanent": true
    }
  ]
}
